<Window x:Class="PuffinProof.UI.SuggestionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PuffinProof"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">
    <Border x:Name="Card"
            Margin="10"
            Padding="12,10,12,10"
            CornerRadius="12"
            Background="#F7F4EF"
            BorderBrush="#E2D9CC"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <StackPanel MinWidth="220" MaxWidth="320">
            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <TextBlock Text="PuffinProof" FontSize="10" FontWeight="SemiBold"
                           Foreground="#8A8175" DockPanel.Dock="Left"/>
                <TextBlock Text="spellcheck only" FontSize="10"
                           Foreground="#B0A89C" DockPanel.Dock="Right"/>
            </DockPanel>
            <TextBlock x:Name="MisspelledText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#C44536"
                       Text="recieve"
                       TextWrapping="Wrap"/>
            <ItemsControl x:Name="SuggestionList" Margin="0,8,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnSuggestionClick"
                                Tag="{Binding Replacement}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Cursor="Hand"
                                Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Row" CornerRadius="8" Padding="8,6" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#EFE8DC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <Border Width="20" Height="20" CornerRadius="6"
                                        Background="#2C2A26" DockPanel.Dock="Left" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Number}"
                                               Foreground="#F7F4EF"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Replacement}"
                                           FontSize="14"
                                           Foreground="#2C2A26"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyHint"
                       Text="No suggestions"
                       Foreground="#8A8175"
                       FontSize="12"
                       Visibility="Collapsed"
                       Margin="0,4,0,8"/>
            <DockPanel>
                <Button x:Name="AddButton" Content="Add word" Click="OnAddClick"
                        Style="{StaticResource GhostButton}" DockPanel.Dock="Left"/>
                <Button x:Name="IgnoreButton" Content="Ignore" Click="OnIgnoreClick"
                        Style="{StaticResource GhostButton}" DockPanel.Dock="Left" Margin="8,0,0,0"/>
                <TextBlock Text="Esc" Foreground="#B0A89C" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
