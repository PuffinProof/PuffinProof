<Window x:Class="PuffinProof.UI.DictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Your words"
        Height="420"
        Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#F7F4EF"
        FontFamily="Segoe UI">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Words you have added. They will never be flagged."
                   Foreground="#6F675C" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Remove selected" Click="OnRemove" DockPanel.Dock="Right" Padding="10,6"/>
            <Button Content="Add" Click="OnAdd" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="10,6"/>
            <TextBox x:Name="NewWordBox" Padding="8,6" VerticalContentAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="WordsList" BorderBrush="#E2D9CC" Background="White"/>
    </DockPanel>
</Window>
