<Window x:Class="JustSpell.Stub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustSpell Setup"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#F7F4EF"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="JustSpell" FontSize="26" FontWeight="SemiBold" Foreground="#2C2A26"/>
            <TextBlock Text="Install or update from GitHub Releases. Windows registers the MSIX."
                       TextWrapping="Wrap" Foreground="#6F675C" Margin="0,6,0,18"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Margin="0,0,0,12"/>
            <Button x:Name="PrimaryButton" Content="Check for latest" Click="OnPrimary"
                    Height="36" FontSize="14" Cursor="Hand"/>
            <Button Content="Install MSIX from this PC…" Click="OnLocalMsi"
                    Margin="0,8,0,0" Height="32" Cursor="Hand"/>
        </StackPanel>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#2C2A26" FontSize="13"/>
    </DockPanel>
</Window>
