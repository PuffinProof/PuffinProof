<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\JustSpell\Assets\justspell.ico</ApplicationIcon>
    <Product>JustSpell</Product>
    <Description>Downloads the latest JustSpell MSI from GitHub Releases and hands it to Windows Installer.</Description>
    <AssemblyName>JustSpellSetup</AssemblyName>
    <RootNamespace>JustSpell.Stub</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustSpell.Core\JustSpell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="feed.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
