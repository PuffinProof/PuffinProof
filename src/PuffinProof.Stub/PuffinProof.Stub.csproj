<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\PuffinProof\Assets\puffinproof.ico</ApplicationIcon>
    <Product>PuffinProof</Product>
    <Description>Downloads the latest PuffinProof MSIX from GitHub Releases and installs it.</Description>
    <AssemblyName>PuffinProofSetup</AssemblyName>
    <RootNamespace>PuffinProof.Stub</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuffinProof.Core\PuffinProof.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="feed.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
