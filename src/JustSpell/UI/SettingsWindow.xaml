<Window x:Class="JustSpell.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustSpell"
        Height="640"
        Width="560"
        MinHeight="520"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#F7F4EF"
        FontFamily="Segoe UI">
    <DockPanel Margin="28,24,28,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="JustSpell" FontSize="26" FontWeight="SemiBold" Foreground="#2C2A26"/>
                <TextBlock Text="Spellcheck for every Windows app. Nothing else."
                           Foreground="#6F675C" Margin="0,4,0,0"/>
                <TextBlock x:Name="VersionText" Foreground="#8A8175" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,16,0,0"
                   Foreground="#8A8175" FontSize="11"
                   Text="100% local. No account. No rewriting. No coaching. Text never leaves this PC."
                   TextWrapping="Wrap"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="EnabledBox" Content="Spellcheck while I type"
                                  FontWeight="SemiBold" Foreground="#2C2A26"/>
                        <CheckBox x:Name="StartupBox" Content="Start with Windows"
                                  Margin="0,10,0,0" Foreground="#2C2A26"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Try it" FontWeight="SemiBold" Foreground="#2C2A26"/>
                        <TextBlock Text="Type a misspelling such as “teh” or “recieve”, then space."
                                   Foreground="#6F675C" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <TextBox x:Name="TryBox"
                                 Height="72"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Padding="10"
                                 FontSize="14"
                                 BorderBrush="#E2D9CC"
                                 Background="White"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="What to check" FontWeight="SemiBold" Foreground="#2C2A26" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Dictionary" VerticalAlignment="Center" Width="140" Foreground="#2C2A26"/>
                            <ComboBox x:Name="LanguageBox" MinWidth="160" ToolTip="Restart JustSpell after switching dictionaries."/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Minimum word length" VerticalAlignment="Center" Width="140" Foreground="#2C2A26"/>
                            <TextBox x:Name="MinLengthBox" Width="60" HorizontalAlignment="Left" Padding="6,4"/>
                        </DockPanel>
                        <CheckBox x:Name="IgnoreDigitsBox" Content="Ignore words that contain digits (Windows11, 3rd)"
                                  Foreground="#2C2A26"/>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Popup stays (seconds)" VerticalAlignment="Center" Width="140" Foreground="#2C2A26"/>
                            <TextBox x:Name="DurationBox" Width="60" HorizontalAlignment="Left" Padding="6,4"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Skip these apps" FontWeight="SemiBold" Foreground="#2C2A26"/>
                        <TextBlock Text="One process name per line, without .exe — for example chrome or keepass."
                                   Foreground="#6F675C" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <TextBox x:Name="ExcludeBox"
                                 Height="90"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Padding="10"
                                 FontFamily="Consolas"
                                 BorderBrush="#E2D9CC"
                                 Background="White"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Shortcuts" FontWeight="SemiBold" Foreground="#2C2A26" Margin="0,0,0,8"/>
                        <TextBlock Foreground="#2C2A26" LineHeight="22" TextWrapping="Wrap"
                                   Text="Ctrl+Alt+S    turn spellcheck on or off&#x0a;Click a suggestion in the popup to apply it. JustSpell watches the focused text field (UI Automation), not the keyboard."/>
                        <Button Content="Edit your words…" Click="OnEditWords"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Padding="12,6" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
